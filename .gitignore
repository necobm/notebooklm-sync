# Secrets — .env holds notebook IDs and profile config, never commit it
.env
.env.*
!.env.example

# Source manifests are personal — only the committed example is tracked
sources/*
!sources/example.yaml

# Local sync database
*.db
*.db-wal
*.db-shm

# Command logs — var/log/YYYY-MM-DD-<command>.log. Local runtime state, and they
# quote notebook IDs and URLs from a personal manifest.
var/

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# engram local sync artifacts
.engram/
