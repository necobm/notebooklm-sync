# Copy to .env and edit. .env is gitignored — keep it that way.

# --- Auth ---------------------------------------------------------------
# NotebookLM has no API key. The upstream CLI uses Google session cookies
# stored per profile. Run `notebooklm login` once to create the profile,
# then name it here.
NOTEBOOKLM_PROFILE=default

# --- Notebooks ----------------------------------------------------------
# Comma-separated list of logical notebook names. For each NAME, define
# NOTEBOOK_<UPPER_NAME>_ID and NOTEBOOK_<UPPER_NAME>_SOURCES.
NOTEBOOKS=research,marketing

NOTEBOOK_RESEARCH_ID=39ce156c-8a96-416a-b840-0d243704391b
NOTEBOOK_RESEARCH_SOURCES=./sources/research.yaml
# Optional per-notebook policy override:
# NOTEBOOK_RESEARCH_POLICY=override

NOTEBOOK_MARKETING_ID=00000000-0000-0000-0000-000000000000
NOTEBOOK_MARKETING_SOURCES=./sources/marketing.yaml

# --- Sync behaviour -----------------------------------------------------
# What to do when a manifest URL already exists in the notebook:
#   skip     - leave the existing source alone (default, safest)
#   override - `notebooklm source refresh` it in place, keeping its ID
#   create   - add another copy anyway (intentional duplicate)
SYNC_POLICY=skip

SYNC_DB_PATH=./notebooklm-sync.db
SYNC_WAIT_TIMEOUT=120
SYNC_CLI_TIMEOUT=300
SYNC_LOG_LEVEL=INFO
